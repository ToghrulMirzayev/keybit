{
  // Cloudflare Workers (static assets). Only the folder produced by `node scripts/build.js` is uploaded.
  "name": "keybit",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    // unknown addresses return 404 with dist/404.html
    "not_found_handling": "404-page"
  }
}
